<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- thread-count="1" -> IllegalArgumentException
     Parallel execution: When mentioned parallel="tests" and thread-count="value" this is called Parallel execution
     parallel="tests" -> this is only acceptable in suite level. If we mentioned this at test level then it be not work.
     **If we are not mentioned thread-count by default testNG will be considered as 5
     -->

<!--example 1:-->
<suite name="Suite" parallel="tests" thread-count="2">
    <test name="Test 1">
        <classes>
            <class name="ex27_testNG.TNG15_parallalExecution.TNG16A_parallalExecution1"/>
        </classes>
    </test>
    <test name="Test 2">
        <classes>
            <class name="ex27_testNG.TNG15_parallalExecution.TNG16A_parallalExecution2"/>
        </classes>
    </test>
    <test name="Test 3">
        <classes>
            <class name="ex27_testNG.TNG15_parallalExecution.TNG16A_parallalExecution3"/>
        </classes>
    </test>
</suite>