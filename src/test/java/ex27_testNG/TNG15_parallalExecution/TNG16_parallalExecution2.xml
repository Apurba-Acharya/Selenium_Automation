        <class name="ex27_testNG.TNG15_parallalExecution.TNG16A_parallalExecution1"/>
        <class name="ex27_testNG.TNG15_parallalExecution.TNG16A_parallalExecution2"/>
        <class name="ex27_testNG.TNG15_parallalExecution.TNG16A_parallalExecution3"/>
    </classes>
</test>

<test name="Test2">
    <classes>
        <class name="ex27_testNG.TNG15_parallalExecution.TNG16A_parallalExecution4"/>
    </classes>
</test>
</suite>