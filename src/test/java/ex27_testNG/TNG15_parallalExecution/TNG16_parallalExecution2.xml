<?xml version="1.0" encoding="UTF-8"?>
<!--
 parallel="tests ::  Each `<test>` tag runs parallel
 parallel="classes :: Each class inside `<test>` runs parallel
-->

<!--Example 2:-->
<suite name="Suite2" parallel="classes" thread-count="2">
<test name="Test1">
