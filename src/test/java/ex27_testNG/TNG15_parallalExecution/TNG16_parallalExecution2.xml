<?xml version="1.0" encoding="UTF-8"?>
<!--
 parallel="tests :  Each <test> tag runs parallel. Where thread-count= number of tests runs in parallel

 parallel="classes" : Each class inside <test> tag runs parallel. Where thread-count= number of classes runs in parallel
-->

<!--Example 2:-->
<suite name="Parallel Execution 2" parallel="classes" thread-count="2">
<test name="Test1">
    <classes>
        <class name="ex27_testNG.TNG15_parallalExecution.TNG16A_parallalExecution1"/>
        <class name="ex27_testNG.TNG15_parallalExecution.TNG16A_parallalExecution2"/>
        <class name="ex27_testNG.TNG15_parallalExecution.TNG16A_parallalExecution3"/>
    </classes>
</test>

<test name="Test2">
    <classes>
        <class name="ex27_testNG.TNG15_parallalExecution.TNG16A_parallalExecution4"/>
    </classes>
</test>
</suite>