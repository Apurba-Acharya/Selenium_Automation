<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--TestNG.Xml file creation structure: suite > test > classes > class > methods > include-->

<suite name="DemoSuite">
    <test name="OrangeHRMLogin">
        <classes>
            <class name="ex27_testNG.TNG1_testNGFileCreationStructure.TNG1B_TNGFileCreationStructure">
                <methods>
                    <include name="LaunchApp"/>
                    <include name="EnterLoginDetails"/>
                    <include name="VerifyMyInfo"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="OrangeHRMMyInfo">
        <classes>
            <class name="ex27_testNG.TNG1_testNGFileCreationStructure.TNG1B_TNGFileCreationStructure">
                <methods>
                    <include name="LaunchApp"/>
                    <include name="EnterLoginDetails"/>
                    <include name="NavigateToMyInfo"/>
                    <include name="VerifyMyInfo"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="TestGoogle">
        <classes>
            <class name="ex27_testNG.TNG1_testNGFileCreationStructure.TNG1A">
                <methods>
                    <include name="testgoogle"/>
                    <include name="testfaceBook"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
