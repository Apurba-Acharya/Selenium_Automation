<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TestNGXML">
    <parameter name="url" value="https://opensource-demo.orangehrmlive.com/"/>
    <parameter name="username" value="Admin"/>
    <parameter name="password" value="admin123"/>
    <parameter name="sleepTime" value="3"/>

    <test name="OrangeHRMLogin" enabled="false">
        <parameter name="browserName" value="edge"/>
        <classes>
            <class name="ex28_testNG.TNG5_enableDisableTestCasesFromMultipleTestNGFiles.TNG6_enableDisableTestCasesFromMultipleTestNGFiles">
                <methods>
                    <include name="LaunchApp"/>
                    <include name="EnterLoginDetails"/>
                    <include name="VerifyLogin"/>
                </methods>
            </class>
        </classes>
    </test>

<!--    If nothing is mentioned / enabled="true" both are same-->

    <test name="OrangeHRMMyInfo">
        <classes>
            <class name="ex28_testNG.TNG5_enableDisableTestCasesFromMultipleTestNGFiles.TNG6_enableDisableTestCasesFromMultipleTestNGFiles">
                <methods>
                    <include name="LaunchApp"/>
                    <include name="EnterLoginDetails"/>
                    <include name="NavigateToMyInfo"/>
                    <include name="VerifyMyInfo"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="TestGoogle/Facebook" enabled="true">
        <classes>
            <class name="ex28_testNG.TNG5_enableDisableTestCasesFromMultipleTestNGFiles.TNG6_enableDisableTestCasesFromMultipleTestNGFiles">
                <methods>
                    <include name="testgoogle"/>
                    <include name="testfaceBook"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
