<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Grouping">
<!--    So only the tests that belong to the sanity group will run across all <test> tags inside the suite.-->
    <groups>
        <run>
            <include name="sanity"/>
        </run>
    </groups>

    <test name="Test 1">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ex28_testNG.TNG8_Grouping.TNG9_groupingTest1"/>
        </classes>
    </test>
    <test name="Test 2">
        <groups>
            <run>
                <include name="functional"/>
            </run>
        </groups>
        <classes>
            <class name="ex28_testNG.TNG8_Grouping.TNG9_groupingTest2"/>
        </classes>
    </test>
</suite>
