<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Grouping">
    <test name="Test">
        <groups>
            <!--Meta groups: Groups of groups: If I want to create daily build or weekly build virtually then define tag is required-->
<!--            Using define tag we can create Meta Groups-->
            <define name="dailyBuild">
                <include name="sanity"/>
                <include name="functional"/>
            </define>
            <define name="weeklyBuild">
                <include name="smoke"/>
                <include name="functional"/>
                <include name="regression"/>
            </define>
            <run>
<!--                Meta groups: Groups of groups:-->
                <include name="weeklyBuild"/>
            </run>
        </groups>
        <classes>
            <class name="ex28_testNG.TNG9_Grouping.TNG9_groupingTest1"/>
            <class name="ex28_testNG.TNG9_Grouping.TNG9_groupingTest2"/>
        </classes>
    </test>
</suite>
